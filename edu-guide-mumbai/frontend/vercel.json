{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/status",
      "destination": "/api/status.js"
    },
    {
      "source": "/api/debug-env",
      "destination": "/api/debug-env.js"
    },
    {
      "source": "/api/debug-db-full",
      "destination": "/api/debug-db-full.js"
    },
    {
      "source": "/api/test",
      "destination": "/api/test.js"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth-minimal.js"
    },
    {
      "source": "/api/colleges/:path*",
      "destination": "/api/colleges.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}