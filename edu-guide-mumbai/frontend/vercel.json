{
  "rewrites": [
    {
      "source": "/api/status",
      "destination": "/api/status.js"
    },
    {
      "source": "/api/debug-env",
      "destination": "/api/debug-env.js"
    },
    {
      "source": "/api/debug-db-full",
      "destination": "/api/debug-db-full.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
